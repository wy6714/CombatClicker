theme_override_font_sizes/font_size = 16
text = "Enemies with a white meter below their HP meter are Break Enemies. 

While their Break Meter is full, they take reduced damage. Empty it completely to trigger a Break. 

Press the corresponding directional buttons, WASD, or click the QTE when the moving indicator reaches the center to unleash a powerful Break Attack. Once broken, attack as rapidly as possible before the Break Meter recovers!
"
autowrap_mode = 2

