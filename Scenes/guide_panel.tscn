offset_right = 374.0
offset_bottom = 272.0
theme_override_fonts/font = ExtResource("6_kil87")
theme_override_font_sizes/font_size = 16
text = "When the blue EXP meter in the top-right fills, you level up.

Each level grants every party member an Upgrade Point—including party members you haven't recruited yet, so no points are ever lost.

Upgrade Points can be spent in each Party Member's Stat Menu or purchased individually for a specific character by clicking their name in the shop.

Enemies also become stronger as your level increases, so spend your Upgrade Points wisely.
"
autowrap_mode = 2

