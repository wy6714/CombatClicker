[node name="ExplanationText" type="Label" parent="TutorialPanelItems/Attacking/ExplanationItems"]
z_index = 21
layout_mode = 0
offset_left = -198.0
offset_top = -15.0
offset_right = 346.0
offset_bottom = 362.0
theme_override_fonts/font = ExtResource("6_kil87")
theme_override_font_sizes/font_size = 16
text = "Click on an enemy to
deal damage. Reduce the enemy’s 
HP to 0 to defeat them and
move on to the next foe.

Press and hold on an enemy
to charge an attack. Release when
the bar is mostly full to 
unleash a powerful Charged Attack. 
Each successful Charged Attack
makes the charge meter fill faster, 
making heavy hits increasingly 
difficult to land consistently.

Press the middle mouse button or 
Space key when you have at
least 100 Ult Charge (the long
yellow bar at the top) to
unleash your Ultimate. At
1000 Ult Charge, press it
to activate Ult Rush instead. 
"
vertical_alignment = 1

