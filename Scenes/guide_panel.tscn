theme_override_fonts/font = ExtResource("6_kil87")
theme_override_font_sizes/font_size = 16
text = "Attack: Determines how much damage you deal. 

Crit Rate: The chance that you deal bonus damage based on crit damage.

Crit Damage: The damage multiplier applied when landing a critical hit.

Ult Regen: Determines how quickly your Ult Charge increases.

Status Rate: The chance you have at applying a status effect based on elemental affinity.

Cooldown: (Party members only.) Determines how frequently they autoattack.
"
autowrap_mode = 2

