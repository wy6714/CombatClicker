[node name="ExplanationText" type="Label" parent="TutorialPanelItems/Elements/ExplanationItems"]
z_index = 21
layout_mode = 0
offset_left = -158.0
offset_top = -331.0
offset_right = 407.0
offset_bottom = 122.0
theme_override_fonts/font = ExtResource("6_kil87")
theme_override_font_sizes/font_size = 16
text = "Determines the status effect that the character has a Status Rate % chance of applying, as well as the buff that a party member’s filled Ult Meter will provide.

Status Effects:

Fire - Burn: Deals moderate damage over time.
Water - Dampen: A portion of damage dealt is applied back to the enemy.
Wind - Dizzy: Critical hits are significantly easier to land.
Electric - Spark: Increases Ult Charge generation on click.
Earth - Petrify: Stores a portion of all damage dealt while active, then releases it as one massive hit when Petrify expires. 

See “Party Members” for the corresponding Ult Buffs.
"
autowrap_mode = 2

