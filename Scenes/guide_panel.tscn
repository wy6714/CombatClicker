[node name="ExplanationText" type="Label" parent="TutorialPanelItems/Ultimate_UltRush/ExplanationItems"]
visible = false
z_index = 21
layout_mode = 0
offset_left = -191.0
offset_top = -124.0
offset_right = 374.0
offset_bottom = 272.0
theme_override_fonts/font = ExtResource("6_kil87")
theme_override_font_sizes/font_size = 16
text = "After pressing the middle mouse button/Space key with at least 1000 Ult Charge, you’ll unleash a flurry of automatic attacks. Join in and attack with clicks, deal heavy damage by using your Ultimate, and rapidly build up your Ult Charge to 1000 again to unleash your Ult Burst on an enemy. 

Maximize your damage, but get your ult charge filled out before time runs out! Ult Bursts instantly defeat any enemy and have a 100% chance to capture them.

Use directional buttons or WASD to perform the Quick Time Events that will briefly extend the Ult Rush Timer.
"
autowrap_mode = 2

